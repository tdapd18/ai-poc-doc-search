# 계리 업무자료 AI 통합검색 PoC 설정 예시 (복사하여 .env 로 사용, 선택사항)
# 이 PoC는 외부 API/인터넷 없이 동작합니다. 비밀번호·API 키를 여기에 넣어 저장소에 커밋하지 마세요.

# LLM 연결 방식: none(기본, 비활성) | mock(테스트용 규칙 기반 가짜 LLM) | internal(사내 승인 LLM - 규격 미정, 미구현)
LLM_PROVIDER=none

# 검색 결과 최대 문서 수 (기본 5)
SEARCH_TOP_K=5

# 데이터/DB 경로 (기본: 프로젝트 내 data/, database/index.db)
# DATA_DIR=data
# INDEX_DB_PATH=database/index.db
